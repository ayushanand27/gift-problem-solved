# Postgres connection string (Neon free tier works well)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Your live site address, used in the QR printed on the wedding card.
# SITE_URL=https://your-site.vercel.app

# Email (confirmation and password reset links). Gmail example: use an app password, not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your Site <you@gmail.com>"
# Shown on the Privacy Policy and Terms pages. Defaults to the MAIL_FROM address.
# CONTACT_EMAIL=
